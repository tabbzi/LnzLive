[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;

render_mode unshaded, skip_vertex_transform, cull_disabled;

uniform bool debug_mode = true;

uniform bool is_babyz_mode = false;

uniform bool should_quantize = false;
uniform int palette_size = 256;
const vec4 TRANSPARENT_COLOR_MAGENTA = vec4(1.0, 0.0, 1.0, 1.0);
const int TRANSPARENT_COLOR_INDEX = 253;

uniform bool render_flat_colors = false;

uniform vec3 base_world_position;
uniform int base_ball_size = 1;
uniform bool transparency_on = true;
uniform sampler2D palette: hint_white;            // 256-color palette lookup
uniform sampler2D petz_palette: hint_white;       // 256-color palette lookup (base Petz palette)
uniform bool is_atlas = false;
uniform vec4 atlas_rect;
uniform vec2 atlas_size;
uniform vec2 texture_size = vec2(256,256);        // declared texture mask size from LNZ
uniform vec2 texture_size_raw;                    // actual texture image size from BMP
uniform sampler2D ball_texture: hint_white;
uniform vec3 z_center_pet_world = vec3(0.0);

uniform vec3 rotation = vec3(0.0);                // rotation in Euler angles
uniform float tiling_unit = 128.0;                // global tiling scale (Reflet: tiles every 128 units in UV space)

varying flat float v_fuzz_amount;
varying flat float v_ball_size;
varying flat float v_outline;
varying flat float v_color_index;
varying flat float v_outline_color_index;
varying flat float v_transparent_index;
varying flat float v_has_texture;
varying flat float v_tile_texture;
varying flat float v_highlight;
varying flat vec3 v_pb_normal;

varying flat vec2 center_fragcoord;
varying flat vec2 base_center_fragcoord;
varying flat float z_center_ball;
varying flat float z_center_pet;

varying flat vec3 view_forward;

// Pseudorandom jitter values for rendering fuzz
float random (float x) {
    return fract(sin(dot(vec2(x),
                         vec2(12.9898,78.233)))*
        43758.5453123);
}

// Apply z-based palette shifts (z-shading)
vec3 get_shifted_color(int palette_index) {
    int new_palette_index;
    
    // Calculate base decade
    int base_decade = int(v_color_index) - int(mod(float(int(v_color_index)), 10.0));

    if (base_decade == 10 && int(v_transparent_index) == 1 && palette_index <= 9) {
        // Keep indices 0-9 on base decade 10
         new_palette_index = palette_index;
    } else if (int(v_transparent_index) == 1 && (palette_index <= 9 || palette_index >= 150)) {
        if (palette_index == 0) {
            // For color 0, drop 2 ramps -21 from base decade and true modulo wrap by 120 for positive index
            new_palette_index = ((base_decade - 21) % 120 + 120) % 120;
        } else {
            // For colors 1-9 and 150-255, apply raw offset and wrap around 256
            int offset = base_decade - 10;
            new_palette_index = (palette_index + offset) % 256;

            // Handle negative wrap in case base decade is 0
            if (new_palette_index < 0) {
                new_palette_index += 256;
            }
        }
    } else {
        // Default z-shading fallback for the 10-149 range
        int ramp_offset = int(mod(float(palette_index), 10.0));

        if (z_center_ball < z_center_pet) {
            ramp_offset = int(min(float(ramp_offset + 2), 9.0));
        } else if (z_center_ball > z_center_pet) {
            ramp_offset = int(max(float(ramp_offset - 1), 0.0));
        }
        
        new_palette_index = base_decade + ramp_offset;
    }

    return texture(palette, vec2(float(new_palette_index) / 255.0, 0.5)).rgb;
}

vec2 calculate_uvs(vec2 offset, vec2 screen_uv, vec2 viewport_size) {
    vec2 tex_coords;
    if (v_tile_texture != 0.0) {
        vec2 center_uv = (center_fragcoord / viewport_size) - vec2(1.0);
        vec2 uv = (screen_uv - center_uv) * (1000.0 / texture_size);

        // Grab true view rotation captured in the vertex shader
        float m6 = view_forward.x;
        float m7 = -view_forward.y;
        float m8 = view_forward.z;

        // Calculate the turn angles in radians
        float angle_u = atan(m6, m8);
        float angle_v = atan(m7, m8);

        // Slide texture a distance equal to angle * radius
        float radius = float(v_ball_size) / 2.0;

        // Divide by texture_size_raw to convert that pixel distance into UV space
        float shift_u = (angle_u * radius) / texture_size_raw.x;
        float shift_v = (angle_v * radius) / texture_size_raw.y;

        // Apply shifts
        uv.x -= shift_u;
        uv.y += shift_v;

        if (is_atlas) {
            vec2 tiled_uv = fract(uv);
            tiled_uv.x = 1.0 - tiled_uv.x;
            tiled_uv.y = 1.0 - tiled_uv.y;
            vec2 atlas_pos = atlas_rect.xy;
            vec2 atlas_dim = atlas_rect.zw;
            tex_coords = (atlas_pos + tiled_uv * atlas_dim) / atlas_size;
        } else {
            tex_coords = fract(uv);
            tex_coords.x = 1.0 - tex_coords.x;
            tex_coords.y = 1.0 - tex_coords.y;
        }
    } else {
        vec2 base_center_offset = (texture_size - texture_size_raw) / 2.0;
        vec2 adj_offset = offset - base_center_offset;
        vec2 snapped_uv = (floor(adj_offset) + 0.5) / texture_size_raw + vec2(0.5);
        if (is_atlas) {
            snapped_uv.x = 1.0 - snapped_uv.x;
            snapped_uv.y = 1.0 - snapped_uv.y;
            vec2 atlas_pos = atlas_rect.xy;
            vec2 atlas_dim = atlas_rect.zw;
            tex_coords = (atlas_pos + snapped_uv * atlas_dim) / atlas_size;
        } else {
            tex_coords = snapped_uv;
            tex_coords.x = 1.0 - tex_coords.x;
            tex_coords.y = 1.0 - tex_coords.y;
        }
    }
    return tex_coords;
}

vec3 get_closest_babyz_color(vec4 original_color, out bool is_transp) {
    if (distance(original_color.rgb, TRANSPARENT_COLOR_MAGENTA.rgb) < 0.01) {
        is_transp = true;
        return TRANSPARENT_COLOR_MAGENTA.rgb;
    }

    vec4 best_color = vec4(0.0);
    float best_distance_sq = 1e20;

    for (int i = 0; i < 256; i++) {
        if (i >= palette_size) break;
        if (i == TRANSPARENT_COLOR_INDEX) continue;

        float babyz_normalized_index = (float(i) + 0.5) / float(palette_size);
        vec4 babyz_color = texture(palette, vec2(babyz_normalized_index, 0.5));
        float distance_sq = dot(original_color.rgb - babyz_color.rgb, original_color.rgb - babyz_color.rgb);

        if (distance_sq < best_distance_sq) {
            best_distance_sq = distance_sq;
            best_color = babyz_color;
        }
    }

    is_transp = false;
    return best_color.rgb;
}

int get_closest_petz_index(vec4 raw_color) {
    if (distance(raw_color.rgb, TRANSPARENT_COLOR_MAGENTA.rgb) < 0.01) {
        return TRANSPARENT_COLOR_INDEX;
    }

    int best_index = 0;
    float best_dist = 1e20;

    for (int i = 0; i < 256; i++) {
        vec4 p_col = texture(petz_palette, vec2((float(i) + 0.5) / 256.0, 0.5));
        float d = distance(raw_color.rgb, p_col.rgb);
        if (d < best_dist) {
            best_dist = d;
            best_index = i;
        }
    }

    return best_index;
}

vec3 apply_palette_shift(int palette_index) {
    int effective_index = palette_index;
    int v_transp = int(v_transparent_index);

    if (v_transp == 80 && palette_index == 1) {
        effective_index = 89;
    } else if (v_transp == 130 && palette_index == 2) {
        effective_index = 139;
    } else if (v_transp == 140 && palette_index == 4) {
        effective_index = 149;
    }

    if (v_transp > 0) {
        if (v_transp == 1 || (effective_index >= v_transp && effective_index < v_transp + 10)) {
            return get_shifted_color(effective_index);
        } else {
            int target_decade = v_transp - int(mod(float(v_transp), 10.0));
            int current_decade = effective_index - int(mod(float(effective_index), 10.0));

            if (current_decade == target_decade) {
                return get_shifted_color(effective_index);
            }
        }
    }

    return texture(palette, vec2(float(effective_index) / 255.0, 0.5)).rgb;
}

void fragment() {
    // CULLING
    // Discard paintballz going in vectors from ballz centers away from camera
    vec3 view_normal = (INV_CAMERA_MATRIX * vec4(v_pb_normal, 0.0)).xyz;

    if (view_normal.z < -0.05) {
        discard;
    }

    vec2 c = center_fragcoord;
    vec2 b = base_center_fragcoord;
    vec2 st = FRAGCOORD.xy;

    // FUZZING
    // Find random number based on y-pixel, offset to center of ball
    float r = random(st.y - c.y);
    // Stretch random number between -1.0 and 1.0
    r = (r * 2.0) - 1.0;
    // Increase distortion by fuzz amount
    r *= float(v_fuzz_amount);
    // Offset x line by the final random amount
    st.x += floor(r);

    // Determine if this paintball is actively textured
    int texture_limit = is_babyz_mode ? 230 : 150;
    bool is_textured = !render_flat_colors && v_has_texture != 0.0 && v_color_index >= 10.0 && v_color_index < float(texture_limit);

    // OUTLINING
    float pct2 = 0.0;
    vec2 st2 = st;
    int effective_outline = is_textured ? -1 : int(v_outline);
    int modified_outline = effective_outline;

    if (effective_outline == -1) {
        // no outline
        modified_outline = 0;
    }
    else if (effective_outline == 0) {
        // one sided outline
        st2.x -= 1.0;
        vec2 vec = st2 - c;
        pct2 = step(length(vec), float(v_ball_size) / 2.0);
        modified_outline = 0;
    }
    else if (effective_outline == -2) {
        // one sided outline
        st2.x += 1.0;
        vec2 vec = st2 - c;
        pct2 = step(length(vec), float(v_ball_size) / 2.0);
        modified_outline = 0;
    }
    else if (effective_outline > 1) {
        vec2 vec = st2 - c;
        pct2 = step(length(vec), float(v_ball_size) / 2.0);
        modified_outline -= 1;
    }
    else if (effective_outline == 1) {
        // dotted outline
        float side = sign(st2.x - c.x);
        st2.x -= 1.0 * side;
        vec2 vec = st2 - c;
        pct2 = step(length(vec), float(v_ball_size) / 2.0);
        modified_outline = 0;
    }
    else if (effective_outline < -1) {
        // use as debug for now
        float side = sign(st2.x - c.x);
        float side2 = sign(st2.y - c.y);
        st2.x -= 1.0 * side;
        st2.y -= 1.0 * side2;
        vec2 vec = st2 - c;
        pct2 = step(length(vec), float(v_ball_size) / 2.0);
        modified_outline = 0;
    }

    // DRAWING
    vec2 vector_from_base_center = st - b;
    vec2 vector_from_center = st - c;

    // Draw a circle.
    // Base ball size gives exact pixel size at camera scale 1.
    float base_pct = step(length(vector_from_base_center), (float(base_ball_size) / 2.0));
    float pct = step(length(vector_from_center), (float(v_ball_size) / 2.0 - float(modified_outline)));

    pct *= base_pct;

    if (effective_outline != -1)
        pct2 -= pct;

    pct2 *= base_pct;

    // TEXTURING & QUANTIZING
    vec3 texture_color;
    bool is_transparent = false;

    if (is_textured) {
        vec2 offset = FRAGCOORD.xy - center_fragcoord;
        vec2 tex_coords = calculate_uvs(offset, SCREEN_UV, VIEWPORT_SIZE);

        float raw_val = texture(ball_texture, tex_coords).r;
        int palette_index = int(round(raw_val * 255.0));

        is_transparent = (palette_index == TRANSPARENT_COLOR_INDEX);

        if (is_babyz_mode) {
            texture_color = texture(palette, vec2(float(palette_index) / 255.0, 0.5)).rgb;
        } else {
            texture_color = apply_palette_shift(palette_index);
        }
    } else {
        // untextured, if range check failed or has_texture is false
        int fill_idx = int(v_color_index) == 0 ? 244 : int(v_color_index);
        texture_color = texture(palette, vec2(float(fill_idx) / 255.0, 0.0)).rgb;
        is_transparent = false;
    }

    int outline_idx = int(v_outline_color_index) == 0 ? 244 : int(v_outline_color_index);
    vec3 outline_color = texture(palette, vec2(float(outline_idx) / 255.0, 0.0)).rgb;
    ALBEDO = vec3(pct * texture_color.rgb + pct2 * outline_color.rgb);

    // Adjust ALPHA based on conditions
    float alpha_value = 1.0;
    if (pct + pct2 == 0.0 || is_transparent) {
        alpha_value = 0.0;
    }

    ALPHA = alpha_value;
    ALPHA_SCISSOR = 1.0;

    if (int(v_highlight) != 0) {
        ALBEDO = vec3(1.0, 1.0, 0.0);
    }
}

void vertex() {
    // Unpack per-paintball attributes from vertex attributes (packed by SurfaceTool)
    v_color_index = float(int(round(COLOR.r * 256.0)) - 1);
    v_outline_color_index = float(int(round(COLOR.g * 256.0)) - 1);
    v_outline = float(int(round(COLOR.b * 256.0)) - 4);
    v_fuzz_amount = float(int(round(COLOR.a * 255.0)));

    v_ball_size = float(int(round(UV2.x)));
    float pb_z_add = UV2.y;

    v_pb_normal = NORMAL;

    v_transparent_index = float(int(round(abs(UV.x))) - 1);
    int flags = int(round(abs(UV.y))) - 1;
    v_has_texture = float(mod(float(flags), 2.0));
    v_tile_texture = float(mod(float(int(float(flags) / 2.0)), 2.0));
    v_highlight = float(mod(float(int(float(flags) / 4.0)), 2.0));

    mat4 original_mv = INV_CAMERA_MATRIX * WORLD_MATRIX;
    view_forward = normalize(original_mv[2].xyz);

    vec4 center_clip_space = original_mv * vec4(VERTEX, 1.0);
    z_center_ball = center_clip_space.z;
    z_center_pet = (INV_CAMERA_MATRIX * vec4(z_center_pet_world, 1.0)).z;

    vec4 center_view = PROJECTION_MATRIX * center_clip_space;
    vec2 center_ndc = (center_view.xy + 1.0) / 2.0;
    center_fragcoord = floor(center_ndc * VIEWPORT_SIZE) + 0.5;

    vec4 base_center_clip_space = INV_CAMERA_MATRIX * vec4(base_world_position, 1.0);
    vec4 base_center_view = PROJECTION_MATRIX * base_center_clip_space;
    vec2 base_center_ndc = (base_center_view.xy + 1.0) / 2.0;
    base_center_fragcoord = floor(base_center_ndc * VIEWPORT_SIZE) + 0.5;

    vec3 vert_in_clip_space = center_clip_space.xyz;
    vert_in_clip_space.z = base_center_clip_space.z + 0.0001 + (pb_z_add * 0.00005);

    float b = (float(v_ball_size) / 2.0 + float(v_fuzz_amount) + 3.0) / (VIEWPORT_SIZE.x / 2.0);
    vert_in_clip_space.x = center_clip_space.x + b * sign(UV.x);
    vert_in_clip_space.y = center_clip_space.y + b * sign(UV.y);

    VERTEX = vert_in_clip_space;
    MODELVIEW_MATRIX = mat4(1.0);
}"

[resource]
resource_local_to_scene = true
shader = SubResource( 1 )
